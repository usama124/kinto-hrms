# Copy to .env and fill in. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kinto_hrms?schema=public"

# Signs session JWTs and (unless MFA_ENC_KEY is set) encrypts MFA secrets at rest.
# REQUIRED in production, at least 32 chars. Generate: openssl rand -base64 48
AUTH_SECRET=""

# ── Optional ──────────────────────────────────────────────────────────────────
# Separate key for MFA-at-rest encryption (falls back to AUTH_SECRET). Changing it locks out enrolled authenticators.
# MFA_ENC_KEY=""

# Auth cookies are Secure in production. Set to "false" only behind a plain-HTTP gateway.
# COOKIE_SECURE=true

# Allow the biometric simulator endpoint in production (demo only; leave unset for real deployments).
# ENABLE_BIOMETRIC_SIMULATOR=false

# ── Scripts only (not read by the running app) ────────────────────────────────
# bun prisma/create-admin.ts
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME=""
# ADMIN_CODE=""

# bun run db:demo-people (shared password for generated demo accounts)
# DUMMY_PASSWORD=""
